# Use this file to set your environment variables
# Copy to .env and replace the values with your own

PORT=3333

# WebUntis login (used by the MCP server)
WEBUNTIS_SCHOOL=meine-schule
WEBUNTIS_USERNAME=max.mustermann
WEBUNTIS_PASSWORD=geheim
# Host only, e.g. "neilo.webuntis.com" (protocol/path are stripped automatically)
WEBUNTIS_URL=neilo.webuntis.com

# Secret that protects the /mcp endpoint – generate e.g. with: openssl rand -hex 32
MCP_SECRET=change-me
